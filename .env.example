# Copy to .env.local and fill in from your Supabase project (Settings → API).
# .env.local is git-ignored. Never commit real keys and never paste them into chat.

# Public values (safe to share — they are sent to every browser anyway)
NEXT_PUBLIC_SUPABASE_URL=https://uogaucwogtnmihnzhhax.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hDNkBY1WvKXBBwFCGGKNEQ_CIyMCj9-
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets — copy from Supabase → Project Settings → API Keys (secret key).
# Put the real value only in .env.local. Never commit it, never paste it in chat.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (32+ chars) that protects the scheduled-job endpoints
CRON_SECRET=

# ---- Messages (emails) ----
# Seals the guest's manage link before it is stored, so a database copy cannot open bookings.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it forever: changing it breaks the links in emails that were not sent yet (bookings stay valid).
MESSAGE_LINK_KEY=
# Email provider (Resend). Leave empty to run in "log" mode: nothing is sent, the admin page shows "Logged".
RESEND_API_KEY=
# Sender on a domain verified at the provider, e.g.  WENRO <bookings@your-domain>
# Production uses: WENRO <bookings@wenro.site> (domain verified in Resend, region eu-west-1)
MAIL_FROM=
# Where guests' replies go (e.g. the team's inbox). Optional.
MAIL_REPLY_TO=
# Receives the 21:00 "not reconfirmed" alert
PLATFORM_ALERT_EMAIL=
# Language of emails to operators and the team (default ar)
OPERATOR_EMAIL_LOCALE=ar

# ---- Photos and videos (Cloudinary) ----
# Without these, photos are stored in Supabase Storage (photos only, up to 4 MB).
# With them, photos and videos upload straight from the browser to Cloudinary and are served from its CDN.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Secret: only in .env.local and the hosting provider's settings
CLOUDINARY_API_SECRET=
# Optional: top folder in your Cloudinary media library (default: wenro)
CLOUDINARY_FOLDER=wenro

# ---- WhatsApp (Meta WhatsApp Business Cloud API) — see docs/whatsapp-templates.md ----
# Without these, WhatsApp messages are only written to the server log ("logged").
# Secret: only in .env.local and the hosting provider's settings
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Languages of the approved templates (default ar,en)
WHATSAPP_TEMPLATE_LANGS=ar,en
# Test phase with Meta's test number: only these numbers (verified in the Meta app, max 5) get messages
WHATSAPP_ALLOWED_TO=
